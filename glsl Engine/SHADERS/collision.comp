#version 450

// Matches SystemCollision::ShaderEntityGPU (three vec4s)
struct ShaderEntityGPU {
    vec4 position; // xyz = position, w = padding
    vec4 velocity; // xyz = velocity, w = padding
    vec4 collider; // x = colliderType, y = radius, z = halfExtentX, w = extra
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint entityCount;
    float dt;
} pc;

// Input (binding 0) and output (binding 1) buffers. std430 for arrays of vec4.
layout(std430, binding = 0) readonly buffer InputBuffer {
    ShaderEntityGPU inEntities[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    ShaderEntityGPU outEntities[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.entityCount) return;

    ShaderEntityGPU self = inEntities[idx];
    vec3 pos = self.position.xyz;
    vec3 vel = self.velocity.xyz;
    float radius = self.collider.y;

    // Simple integration
    pos += vel * pc.dt;

    // Naive sphere-sphere collision handling (local-only)
    const float separationBias = 0.01;
    const float restitution = 0.9; // simple energy retention on bounce
    for (uint j = 0u; j < pc.entityCount; ++j)
    {
        if (j == idx) continue;

        ShaderEntityGPU other = inEntities[j];
        float otherRadius = other.collider.y;

        if (radius <= 0.0 || otherRadius <= 0.0) continue; // skip non-spherical or unspecified

        vec3 posOther = other.position.xyz;
        vec3 velOther = other.velocity.xyz;

        vec3 delta = pos - posOther;
        float dist = length(delta);

        // Prevent division by zero; if coincident, n defaults to up
        if (dist <= 1e-6) {
            delta = vec3(0.0, 1.0, 0.0);
            dist = 1.0;
        }

        float minDist = radius + otherRadius;
        if (dist < minDist)
        {
            vec3 n = delta / dist;
            float penetration = minDist - dist;

            // Depenetrate this entity by a fraction (simple symmetric bias)
            pos += n * (penetration * 0.5 + separationBias);

            // Simple response: if moving into the collision, reflect the component along the normal
            float approach = dot(vel, n);
            if (approach < 0.0)
            {
                // reflect and apply restitution
                vec3 v_normal = approach * n;
                vec3 v_tangent = vel - v_normal;
                vel = v_tangent - v_normal * restitution;
            }
        }
    }

    // Keep balls inside a 30x30x30 area centered at origin (half-extent = 15)
    // If an entity goes outside, clamp position to the boundary and reflect velocity with some restitution.
    const vec3 halfBounds = vec3(5.0);
    const float wallRestitution = 0.8;
    // X axis
    if (pos.x > halfBounds.x) {
        pos.x = halfBounds.x;
        if (vel.x > 0.0) vel.x = -vel.x * wallRestitution;
    } else if (pos.x < -halfBounds.x) {
        pos.x = -halfBounds.x;
        if (vel.x < 0.0) vel.x = -vel.x * wallRestitution;
    }
    // Y axis
    if (pos.y > halfBounds.y) {
        pos.y = halfBounds.y;
        if (vel.y > 0.0) vel.y = -vel.y * wallRestitution;
    } else if (pos.y < -halfBounds.y) {
        pos.y = -halfBounds.y;
        if (vel.y < 0.0) vel.y = -vel.y * wallRestitution;
    }
    // Z axis
    if (pos.z > halfBounds.z) {
        pos.z = halfBounds.z;
        if (vel.z > 0.0) vel.z = -vel.z * wallRestitution;
    } else if (pos.z < -halfBounds.z) {
        pos.z = -halfBounds.z;
        if (vel.z < 0.0) vel.z = -vel.z * wallRestitution;
    }

    // Write back results (preserve collider metadata as input)
    outEntities[idx].position = vec4(pos, 0.0);
    outEntities[idx].velocity = vec4(vel, 0.0);
    outEntities[idx].collider = self.collider;
}